&config
    path_dz         = '/path/to/DZ_C3072_1440x720.fre.nc',
    path_temp       = '/path/to/temp_coarse_C3072_1440x720.fre.nc',
    path_omega      = '/path/to/ptend_coarse_C3072_1440x720.fre.nc',
    path_qv         = '/path/to/sphum_coarse_C3072_1440x720.fre.nc',
    path_qw         = '/path/to/liq_wat_coarse_C3072_1440x720.fre.nc',
    path_qr         = '/path/to/rainwat_coarse_C3072_1440x720.fre.nc',
    path_qi         = '/path/to/ice_wat_coarse_C3072_1440x720.fre.nc',
    path_qs         = '/path/to/snowwat_coarse_C3072_1440x720.fre.nc',
    path_qg         = '/path/to/graupel_coarse_C3072_1440x720.fre.nc',
    path_omt        = '/path/to/omT_coarse_C3072_1440x720.fre.nc',
    path_omqv       = '/path/to/omqv_coarse_C3072_1440x720.fre.nc',
    path_omqw       = '/path/to/omql_coarse_C3072_1440x720.fre.nc',
    path_omqr       = '/path/to/omqr_coarse_C3072_1440x720.fre.nc',
    path_omqi       = '/path/to/omqi_coarse_C3072_1440x720.fre.nc',
    path_omqs       = '/path/to/omqs_coarse_C3072_1440x720.fre.nc',
    path_omqg       = '/path/to/omqg_coarse_C3072_1440x720.fre.nc',
    path_pr         = '/path/to/PRATEsfc_coarse_C3072_1440x720.fre.nc',

    path_hist_out   = '/path/to/hist_monthly_by_lat_band_output.nc',

    ! Number of latitude bands for histogram partitioning.
    nlat_bands      = 18,

    ! If true, lat_band_bounds_count must be nlat_bands + 1 and lat_band_bounds
    ! must contain strictly increasing boundaries inside [-90, 90].
    use_custom_lat_band_bounds = .false.,
    lat_band_bounds_count = 0,

    ! Optional custom boundaries example for 6 bands:
    ! lat_band_bounds_count = 7,
    ! lat_band_bounds = -90.0, -60.0, -30.0, 0.0, 30.0, 60.0, 90.0,
/
