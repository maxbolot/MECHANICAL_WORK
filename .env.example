# Environment configuration for MECHANICAL_WORK
# Copy this file to .env or .env.local to override local paths

# Local storage roots on Thinkpad P51 (4TB volume)
GLOBALFV3_DATA_ROOT=/media/max/data/climate_work/processed
GLOBALFV3_RAW_ROOT=/media/max/data/climate_work/raw

# Princeton HPC cluster connection
HPC_HOST=stellar-vis1.princeton.edu
HPC_USER=mbolot

# Remote HPC data directories
HPC_PROCESSED_DIR=/scratch/gpfs/mbolot/results/GLOBALFV3
HPC_RAW_DIR=/scratch/cimes/GLOBALFV3
HPC_LOCAL_DIR=/home/mbolot/local

# Local Intel oneAPI initialization (if not in ~/.bashrc)
ONEAPI_SETVARS=/opt/intel/oneapi/setvars.sh

# Conda environment providing cdo, nco, etc.
CONDA_ENV=geo

